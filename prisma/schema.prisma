// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model CategoryEvent {
  id        Int      @id @default(autoincrement())
  nama      String
  events    Event[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("categories")
}

model Pembicara {
  id          Int      @id @default(autoincrement())
  nama        String
  jabatan     String
  sosialMedia String?  @map("sosial_media")
  events      Event[]
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("pembicaras")
}

model Event {
  id          Int           @id @default(autoincrement())
  nama        String
  lokasi      String
  tanggal     DateTime      @map("date_event")
  description String        @db.Text
  categoryId  Int           @map("category_id")
  category    CategoryEvent @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  pembicaraId Int           @map("pembicara_id")
  pembicara   Pembicara     @relation(fields: [pembicaraId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now()) @map("created_at")

  @@map("events")
}
